generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String      @id @default(cuid())
  slug                   String      @unique @default("")
  name                   String
  email                  String      @unique
  password               String
  phone                  String      @default("")
  whatsapp               String      @default("")
  companyName            String      @default("")
  listInMarketplace      Boolean     @default(false)
  currency               String      @default("USD")
  locale                 String      @default("ar")
  role                   String      @default("tenant")
  subscriptionStatus     String      @default("active")
  subscriptionStartDate  DateTime?
  subscriptionExpiryDate DateTime?
  defaultFeeType         String?
  defaultFeeValue        Float?
  lastLoginAt            DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  properties             Property[]
  inquiries              Inquiry[]
}

model Amenity {
  id        String            @id @default(cuid())
  nameAr    String
  nameEn    String
  icon      String            @default("check")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  properties PropertyAmenity[]
}

model PropertyAmenity {
  id         String   @id @default(cuid())
  propertyId String
  amenityId  String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, amenityId])
}

model Property {
  id            String            @id @default(cuid())
  slug          String            @default("")
  userId        String
  title         String
  address       String
  city          String            @default("")
  type          String
  description   String            @default("")
  images        String            @default("[]")
  thumbnail     Int               @default(0)
  status        String            @default("available")
  ownershipType String            @default("owned")
  ownerName     String?
  ownerPhone    String?
  feeType       String?
  feeValue      Float?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  rentals       Rental[]
  amenities     PropertyAmenity[]
}

model Rental {
  id            String    @id @default(cuid())
  propertyId    String
  tenantName    String
  tenantPhone   String    @default("")
  monthlyAmount Float
  startDate     DateTime
  endDate       DateTime
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  payments      Payment[]
}

model Payment {
  id         String    @id @default(cuid())
  rentalId   String
  monthLabel String
  dueDate    DateTime
  amount     Float
  status     String    @default("unpaid")
  paidAt     DateTime?
  notes      String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  rental     Rental    @relation(fields: [rentalId], references: [id], onDelete: Cascade)
}

model Inquiry {
  id            String   @id @default(cuid())
  userId        String
  propertyId    String
  propertyTitle String
  senderName    String
  senderPhone   String   @default("")
  message       String   @default("")
  status        String   @default("new")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
